{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplus:file-commands:v1",
  "title": "MDPlus application IPC contract",
  "description": "Application commands are allowed only in the local main window. Properties use camelCase. Document revisions identify bytes, never timestamps; null expectedRevision requires a missing target. File errors preserve unsaved content and retained copies. HTML export and recovery/settings have separate validation boundaries. See docs/ipc.md.",
  "x-commands": {
    "read_document": {
      "request": "#/$defs/PathRequest",
      "response": "#/$defs/DocumentSnapshot",
      "error": "#/$defs/FileError"
    },
    "document_revision": {
      "request": "#/$defs/PathRequest",
      "response": "#/$defs/RevisionState",
      "error": "#/$defs/FileError"
    },
    "write_document": {
      "request": "#/$defs/WriteRequest",
      "response": "#/$defs/WriteReceipt",
      "error": "#/$defs/FileError"
    },
    "save_image_asset": {
      "request": "#/$defs/ImageRequest",
      "response": "#/$defs/ImageReceipt",
      "error": "#/$defs/FileError"
    },
    "export_html": {
      "request": "#/$defs/ExportHtmlRequest",
      "response": "#/$defs/Void",
      "error": "#/$defs/StringError"
    },
    "read_image_file": {
      "request": "#/$defs/ImageReadRequest",
      "response": "#/$defs/ImageFile",
      "error": "#/$defs/StringError"
    },
    "load_settings": {
      "request": "#/$defs/EmptyRequest",
      "response": "#/$defs/SettingsSnapshot",
      "error": "#/$defs/StringError"
    },
    "save_settings": {
      "request": "#/$defs/SettingsWriteRequest",
      "response": "#/$defs/SettingsReceipt",
      "error": "#/$defs/StringError"
    },
    "take_startup_files": {
      "request": "#/$defs/EmptyRequest",
      "response": "#/$defs/Paths",
      "error": "#/$defs/StringError"
    },
    "take_pending_open_files": {
      "request": "#/$defs/EmptyRequest",
      "response": "#/$defs/Paths",
      "error": "#/$defs/StringError"
    },
    "cache_recovery_image": {
      "request": "#/$defs/RecoveryImageRequest",
      "response": "#/$defs/RecoveryCleanup",
      "error": "#/$defs/StringError"
    },
    "write_recovery_snapshot": {
      "request": "#/$defs/RecoveryWriteRequest",
      "response": "#/$defs/RecoveryCleanup",
      "error": "#/$defs/StringError"
    },
    "list_recovery_snapshots": {
      "request": "#/$defs/RecoveryListRequest",
      "response": "#/$defs/RecoveryEntries",
      "error": "#/$defs/StringError"
    },
    "read_recovery_snapshot": {
      "request": "#/$defs/RecoveryIdRequest",
      "response": "#/$defs/RestoredSnapshot",
      "error": "#/$defs/StringError"
    },
    "delete_recovery_snapshot": {
      "request": "#/$defs/RecoveryIdRequest",
      "response": "#/$defs/Void",
      "error": "#/$defs/StringError"
    },
    "commit_image_assets": {
      "request": "#/$defs/AllocationIdsRequest",
      "response": "#/$defs/Void",
      "error": "#/$defs/StringError"
    },
    "discard_image_assets": {
      "request": "#/$defs/AllocationIdsRequest",
      "response": "#/$defs/Void",
      "error": "#/$defs/StringError"
    },
    "stash_image": {
      "request": "#/$defs/StashImageRequest",
      "response": "#/$defs/StashReceipt",
      "error": "#/$defs/StringError"
    },
    "import_dropped_image": {
      "request": "#/$defs/DroppedImageRequest",
      "response": "#/$defs/DroppedImageReceipt",
      "error": "#/$defs/StringError"
    },
    "read_stashed_image": {
      "request": "#/$defs/StashKeyRequest",
      "response": "#/$defs/StashedImage",
      "error": "#/$defs/StringError"
    },
    "discard_stashed_images": {
      "request": "#/$defs/StashKeysRequest",
      "response": "#/$defs/Void",
      "error": "#/$defs/StringError"
    }
  },
  "$defs": {
    "PathRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DocumentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content", "revision", "mtime"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Validated absolute document target. The native canonical parent resolves relative paths and dot segments; Windows consumers compare case, separators and extended prefixes equivalently."
        },
        "content": {
          "type": "string",
          "description": "Decoded lossless text, with no U+0000 (NUL); its UTF-8 byte length also fits textFileBytes so it can be saved and reopened."
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "mtime": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RevisionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "mtime"],
      "description": "Both values are null only for NotFound. Permission, sharing, size, and invalid-path errors reject rather than pretending the file is missing. Does not decode the text, so it can inspect an explicitly selected replacement target.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Validated absolute target, even when revision and mtime are null. Use this identity for Save As collision checks before writing."
        },
        "revision": {
          "type": ["string", "null"]
        },
        "mtime": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "WriteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content", "expectedRevision"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "description": "UTF-8 byte length must fit textFileBytes; NUL is rejected before creating staging files or modifying the target."
        },
        "expectedRevision": {
          "type": ["string", "null"],
          "description": "null means create only if absent. An existing target requires the exact revision last read or explicitly confirmed. There is no force flag."
        }
      }
    },
    "WriteReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "mtime", "backupPath"],
      "description": "Only returned after verified commit. revision/mtime describe the committed local bytes, not a later unrelated file read. Verified commits clean temporary copies where possible; backupPath is non-null if a previous-version backup could not be removed. Uncertain/conflicted replacements reject with retained paths.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Validated absolute target of the verified write."
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "mtime": {
          "type": "integer",
          "minimum": 0
        },
        "backupPath": {
          "type": ["string", "null"]
        }
      }
    },
    "ImageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docPath", "filename", "dataBase64"],
      "description": "Validate basename, supported image and capacity; create only under sibling assets with an opaque allocation token. An identical completed image may be reused without any deletion authority. New allocations must be finalized by commit or discard.",
      "properties": {
        "docPath": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "dataBase64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 89478488,
          "description": "Canonical padded STANDARD base64. Encoded length is checked before allocation, decoded bytes are separately limited to imageFileBytes and type-validated; JSON numeric arrays are not accepted."
        }
      }
    },
    "ImageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "relativePath", "path", "allocationId"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "type": "string",
          "pattern": "^\\./assets/"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "allocationId": {
          "type": ["string", "null"],
          "description": "Opaque process-owned deletion lease for a newly-created image; null for reused existing bytes. Only unchanged document outcomes permit discard; unknown/committed outcomes must commit (retain)."
        }
      }
    },
    "FileError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "path",
        "recoveryPath",
        "backupPath",
        "actualRevision",
        "writeState"
      ],
      "properties": {
        "code": {
          "enum": [
            "CONFLICT",
            "INVALID_ENCODING",
            "INVALID_PATH",
            "TOO_LARGE",
            "BUSY",
            "IO_ERROR",
            "RECOVERY_REQUIRED"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "recoveryPath": {
          "type": ["string", "null"],
          "description": "Durable local draft when available; never a consumed staging filename."
        },
        "backupPath": {
          "type": ["string", "null"],
          "description": "Retained previous on-disk bytes when available. Do not overwrite the target automatically to roll back a conflict."
        },
        "actualRevision": {
          "type": ["string", "null"]
        },
        "writeState": {
          "enum": ["unchanged", "committed", "unknown"],
          "description": "unchanged: this operation did not replace the target. committed: replacement occurred but must not be accepted as a clean save. unknown: OS replacement may have partially changed paths. Always keep dirty content and show retained paths."
        }
      }
    },
    "EmptyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "Void": {
      "type": "null"
    },
    "StringError": {
      "type": "string"
    },
    "SettingsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "revision"],
      "properties": {
        "values": {
          "type": "object"
        },
        "revision": {
          "type": ["string", "null"]
        }
      }
    },
    "SettingsWriteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "expectedRevision"],
      "description": "Fixed native settings path only. Complete JSON must fit settingsFileBytes; the exact loaded revision is required. No implicit exit save exists.",
      "properties": {
        "values": {
          "type": "object"
        },
        "expectedRevision": {
          "type": ["string", "null"]
        }
      }
    },
    "SettingsReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ExportHtmlRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Validated regular .html target. Other extensions and device paths are rejected."
        },
        "content": {
          "type": "string",
          "description": "UTF-8 bytes must fit config/application.json htmlExportBytes (512 MiB), independently of the 32 MiB Markdown limit. The same export budget applies to all revision/backup checks."
        }
      }
    },
    "ImageReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docPath", "relativePath"],
      "properties": {
        "docPath": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "description": "Relative image beneath the validated regular document directory; absolute paths and escapes are rejected."
        }
      }
    },
    "ImageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mime", "dataBase64"],
      "properties": {
        "path": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "dataBase64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 89478488,
          "description": "Canonical padded STANDARD base64. Encoded length is checked before allocation, decoded bytes are separately limited to imageFileBytes and type-validated; JSON numeric arrays are not accepted."
        }
      }
    },
    "RecoveryIdRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9-]+$"
        }
      }
    },
    "RecoveryImageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "stashKey", "retainedKeys"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "stashKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "Key of a pinned process-owned image stash handle; native code copies its immutable bytes without transferring Base64 through the WebView."
        },
        "retainedKeys": {
          "$ref": "#/$defs/RecoveryRetainedKeys"
        }
      }
    },
    "RecoveryImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeholder", "filename", "key"],
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "RecoverySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "originalPath", "markdown", "images"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "originalPath": {
          "type": ["string", "null"]
        },
        "markdown": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoveryImage"
          },
          "maxItems": 128
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RecoveryWriteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "retainedKeys"],
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/RecoverySnapshot"
        },
        "retainedKeys": {
          "$ref": "#/$defs/RecoveryRetainedKeys"
        }
      }
    },
    "RecoveryRetainedKeys": {
      "type": "array",
      "maxItems": 4096,
      "description": "In-flight image/capture keys, not a persisted snapshot field. Native code also retains the last complete disk manifest before publication.",
      "items": {
        "type": "string",
        "maxLength": 105,
        "pattern": "^[A-Za-z0-9-]+\\.(png|jpg|jpeg|gif|webp|svg)$"
      }
    },
    "RecoveryCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["removedKeys", "cleanupError"],
      "properties": {
        "removedKeys": { "$ref": "#/$defs/RecoveryRetainedKeys" },
        "cleanupError": {
          "type": ["string", "null"],
          "description": "Auxiliary cleanup failure. A successful manifest write remains durable; callers invalidate cached-key knowledge and retry cleanup on a later write."
        }
      }
    },
    "RecoveryListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeIds"],
      "properties": {
        "activeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9-]+$"
          }
        }
      }
    },
    "RecoveryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "originalPath", "updatedAt", "damaged"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "originalPath": {
          "type": ["string", "null"]
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "damaged": {
          "type": "boolean"
        }
      }
    },
    "RecoveryEntries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecoveryEntry"
      }
    },
    "RestoredImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeholder", "filename", "key", "dataBase64", "mime"],
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "dataBase64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 89478488,
          "description": "Canonical padded STANDARD base64. Encoded length is checked before allocation, decoded bytes are separately limited to imageFileBytes and type-validated; JSON numeric arrays are not accepted."
        }
      }
    },
    "RestoredSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "images"],
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/RecoverySnapshot"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RestoredImage"
          }
        }
      }
    },
    "AllocationIdsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allocationIds"],
      "properties": {
        "allocationIds": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[0-9a-f]{32}$"
          }
        }
      }
    },
    "StashImageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "dataBase64"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "dataBase64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 89478488,
          "description": "Canonical padded STANDARD base64. Encoded length is checked before allocation, decoded bytes are separately limited to imageFileBytes and type-validated; JSON numeric arrays are not accepted."
        }
      }
    },
    "StashKeyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "DroppedImageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit user-dropped absolute PNG/JPG/JPEG regular file. Device paths, leaf links/reparse points, extension/content mismatches, corrupt images and capacity violations are rejected. Source bytes are copied unchanged into process-owned stash; discard never deletes the user's original. This does not widen read_image_file's document-relative boundary."
        }
      }
    },
    "DroppedImageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "mime", "previewUrl", "filename", "byteLength", "digest"],
      "properties": {
        "key": { "type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[0-9a-f]{32}$" },
        "mime": { "enum": ["image/png", "image/jpeg"] },
        "previewUrl": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "StashKeysRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "keys": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[0-9a-f]{32}$"
          }
        }
      }
    },
    "StashReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "mime", "previewUrl"],
      "properties": {
        "key": { "type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[0-9a-f]{32}$" },
        "mime": { "type": "string" },
        "previewUrl": {
          "type": "string",
          "description": "Process-local read-only mdplus-image-stash URL; Windows uses http://mdplus-image-stash.localhost/<key>. Preview only: exported standalone documents must inline bytes, not retain this URL."
        }
      }
    },
    "StashedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mime", "dataBase64"],
      "properties": {
        "mime": {
          "type": "string"
        },
        "dataBase64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 89478488,
          "description": "Canonical padded STANDARD base64. Encoded length is checked before allocation, decoded bytes are separately limited to imageFileBytes and type-validated; JSON numeric arrays are not accepted."
        }
      }
    }
  }
}
