{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-available-monitors",
    "core:window:allow-unminimize",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "allow-read-document",
    "allow-document-revision",
    "allow-write-document",
    "allow-save-image-asset",
    "allow-commit-image-assets",
    "allow-discard-image-assets",
    "allow-stash-image",
    "allow-read-stashed-image",
    "allow-discard-stashed-images",
    "allow-export-html",
    "allow-read-image-file",
    "allow-take-startup-files",
    "allow-take-pending-open-files",
    "allow-cache-recovery-image",
    "allow-write-recovery-snapshot",
    "allow-list-recovery-snapshots",
    "allow-read-recovery-snapshot",
    "allow-delete-recovery-snapshot",
    "allow-load-settings",
    "allow-save-settings"
  ]
}
