{
  "name": "mdplus",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:browser": "tsc --project tsconfig.browser.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run config:check && npm run typecheck && npm run typecheck:browser && npm run test:coverage",
    "build": "npm run config:check && npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "lint": "eslint src tests scripts config *.ts *.mjs --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:sync": "node scripts/sync-config.mjs --write",
    "config:check": "node scripts/sync-config.mjs",
    "test:coverage": "vitest run --coverage",
    "audit:deps": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@milkdown/kit": "^7.21.3",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/plugin-prism": "^7.21.3",
    "@milkdown/react": "^7.21.3",
    "@milkdown/theme-nord": "^7.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "katex": "0.18.2",
    "mermaid": "11.16.1",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/prismjs": "^1.26.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "$katex",
    "minimatch": "^11.0.4"
  }
}
